<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Invoice - {{monthUpto}}</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }

        .page {
            width: 210mm;
            /* A4 width */
            height: 297mm;
            /* A4 height */
            padding: 10mm;
            margin: 0 auto;
            background: white;
            box-sizing: border-box;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 40px;
        }

        .logo-section {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .logo {
            width: 60px;
            height: 60px;
        }

        .company-info h1 {
            margin: 0;
            font-size: 24px;
            color: #000;
        }

        .company-info p {
            margin: 5px 0;
            color: #666;
        }

        .invoice-title {
            font-size: 24px;
            font-weight: bold;
            text-align: right;
        }

        .invoice-number {
            text-align: right;
            color: #666;
        }

        .student-info {
            display: flex;
            justify-content: space-between;
            margin-bottom: 20px;
        }

        .dates {
            display: flex;
            justify-content: space-between;
            margin-bottom: 30px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }

        th {
            background-color: #f0f0f0;
            padding: 10px;
            text-align: left;
        }

        td {
            padding: 10px;
            border-bottom: 1px solid #eee;
        }

        .amount-column {
            text-align: right;
        }

        .grand-total {
            display: flex;
            justify-content: space-between;
            padding: 10px;
            border: 1px solid #eee;
            margin-bottom: 20px;
            border-radius: 4px;
            font-weight: bold;
        }

        .amount-words {
            margin-bottom: 40px;
            text-align: right;
        }

        .payment-terms {
            margin-bottom: 60px;
        }

        .signature {
            text-align: right;
            border-top: 1px solid #000;
            padding-top: 10px;
            width: 200px;
            float: right;
        }

        .print-button {
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            background: #000;
            color: white;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
            border: none;
        }

        @media print {
            .print-button {
                display: none;
            }
        }
    </style>
</head>

<body>
    <div class="page">
        <div class="header">
            <div class="logo-section">
                <svg class="logo" viewBox="0 0 100 100">
                    <rect x="20" y="20" width="60" height="60" fill="black" />
                    <circle cx="50" cy="40" r="10" fill="white" />
                    <rect x="40" y="45" width="20" height="25" fill="white" />
                </svg>
                <div class="company-info">
                    <h1>{{schoolName}}</h1>
                    <p>{{schoolAddress}}</p>
                    <p>Phone: {{schoolPhone}}</p>
                </div>
            </div>
            <div>
                <div class="invoice-title">INVOICE</div>
                <div class="invoice-number">Invoice #: {{invoiceNumber}}</div>
            </div>
        </div>

        <div class="student-info">
            <div>
                <strong>Student ID:</strong> {{studentId}}<br>
                <strong>Student Name:</strong> {{studentName}}
            </div>
            <div>
                <strong>Class:</strong> {{className}}
            </div>
        </div>

        <div class="dates">
            <div>
                <strong>Invoice Date:</strong> {{invoiceDate}}<br>
                <strong>Due Date:</strong> {{dueDate}}
            </div>
            <div>
                <strong>Month Upto:</strong> {{monthUpto}}
            </div>
        </div>

        <table>
            <thead>
                <tr>
                    <th>Charge Head</th>
                    <th class="amount-column">Amount</th>
                    <th class="amount-column">Discount (%)</th>
                    <th class="amount-column">Total</th>
                </tr>
            </thead>
            <tbody>
                {{#each charges}}
                <tr>
                    <td>{{name}}</td>
                    <td class="amount-column">{{amount}}</td>
                    <td class="amount-column">{{discount}}</td>
                    <td class="amount-column">{{total}}</td>
                </tr>
                {{/each}}
            </tbody>
        </table>

        <div class="grand-total">
            <span>Grand Total:</span>
            <span>{{currency}} {{grandTotal}}</span>
        </div>

        <div class="amount-words">
            <strong>Amount in Words:</strong> {{amountInWords}}
        </div>

        <div class="payment-terms">
            <strong>Payment Terms:</strong><br>
            Please make payment before the due date
        </div>

        <div class="signature">
            Authorized Signature
        </div>
    </div>
</body>

</html>