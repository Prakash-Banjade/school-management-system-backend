<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Password Reset Request - {{schoolName}}</title>
</head>

<body style="margin: 0; padding: 0; font-family: Arial, sans-serif; background-color: #f4f4f4;">
    <div style="width: 100%; display: table;">
        <div style="display: table-cell; padding: 20px 0;">
            <div
                style="max-width: 600px; margin: 0 auto; background-color: #ffffff; border-radius: 8px; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);">
                <!-- Header -->
                <div
                    style="text-align: center; padding: 30px 0 30px; background-color: #003366; border-top-left-radius: 8px; border-top-right-radius: 8px;">
                    <img src="{{schoolLogo}}" alt="{{schoolName}} Logo" style="max-width: 80px; height: auto;">
                </div>
                <!-- Content -->
                <div style="padding: 0 30px;">
                    {{{noticeContent}}}
                </div>
                <!-- Footer -->
                <div
                    style="padding: 30px 30px; background-color: #e6f2ff; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;">
                    <p style="color: #666666; font-size: 14px; line-height: 1.5; margin: 0;">{{schoolName}}
                    </p>
                    <p style="color: #666666; font-size: 14px; line-height: 1.5; margin: 5px 0 0;">
                        {{schoolAddress}}</p>
                    <p style="color: #666666; font-size: 14px; line-height: 1.5; margin: 10px 0 0;">
                        <a href="{{clientUrl}}" style="color: #009933; text-decoration: none;">IT Support</a> |
                        <a href="{{clientUrl}}" style="color: #009933; text-decoration: none;">Privacy
                            Policy</a> |
                        <a href="{{clientUrl}}" style="color: #009933; text-decoration: none;">Terms of
                            Service</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</body>

</html>